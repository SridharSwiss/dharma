}

/* ---------- RESOURCES ---------- */
function drawResources() {
  const bars = $('#bud-bars');
  if (!failBox(bars, 'budget')) {
    const rs = rowsOf('budget').filter((r) => r.section === 'నెలవారీ');
    const mx = d3.max(rs, (r) => Number(r.high)) || 1;
    bars.replaceChildren(...rs.map((r) => {
      const row = el('div', 'sv-hrow'); const tr = el('div', 'sv-track'); const f = el('div', 'sv-fill');
      f.style.setProperty('--c', colr(0)); f.style.left = (Number(r.low) / mx * 100) + '%'; f.style.width = Math.max(1.5, (Number(r.high) - Number(r.low)) / mx * 100) + '%';
      const lo = el('div', 'sv-fill'); lo.style.setProperty('--c', 'var(--cds-chart-muted)'); lo.style.left = '0'; lo.style.width = (Number(r.low) / mx * 100) + '%'; lo.style.opacity = .35;
      tr.append(lo, f);
      const lab = el('span', '', r.item); lab.style.lineHeight = '1.35';
      row.append(lab, tr, el('span', 'sv-num', (Number(r.low) / 1000) + '–' + (Number(r.high) / 1000) + ' వే'));
      return row;
    }));
  }
  const tb = $('#six-tbl tbody'); const brs = rowsOf('budget');
  if (brs) {
    tb.replaceChildren(...brs.filter((r) => r.section !== 'నెలవారీ').map((r) => {
      const tr = el('tr'); tr.dataset.key = r.key; if (r.section === 'ప్రత్యామ్నాయం') tr.style.color = 'var(--color-fg-muted)';
      const it = el('td'); it.append(el('div', '', r.item), el('div', 'sub', r.section + ' · ' + r.basis)); it.lastChild.style.cssText = 'color:var(--color-fg-muted)';
      tr.append(it, el('td', 'n', inr(r.low)), el('td', 'n', inr(r.high)), el('td', 'n', Number(r.low_chf).toLocaleString('en')), el('td', 'n', Number(r.high_chf).toLocaleString('en')));
      return tr;
    }));
  } else tb.replaceChildren();
  const rrs = rowsOf('resources'); const cats = rrs ? [...new Set(rrs.map((r) => r.cat))] : [];
  chips($('#re-cat'), [['all', 'అన్నీ', null], ...cats.map((c, i) => [c, c, colr(i + 4)])], state.reCat, (v) => { state.reCat = v; drawResources(); });
  const rtb = $('#re-tbl tbody');
  if (!rrs) { rtb.replaceChildren(); return; }
  rtb.replaceChildren(...rrs.filter((r) => state.reCat === 'all' || r.cat === state.reCat).map((r) => {
    const tr = el('tr'); tr.dataset.key = r.key;
    const src = el('td'); if (r.source) { const a = el('a', '', 'లింక్ ↗'); a.href = r.source; a.target = '_blank'; a.rel = 'noopener'; a.style.color = 'var(--color-fg-muted)'; src.append(a); }
    const it = el('td', '', r.item); it.style.fontWeight = 'var(--cds-font-weight-medium)';
    tr.append(el('td', '', r.cat), it, el('td', '', r.detail), el('td', '', r.cost), src);
    return tr;
  }));
}

/* ---------- RULES ---------- */
function drawRules() {
  const box = $('#rule-groups');
  if (failBox(box, 'rules')) return;
  const rs = rowsOf('rules'); const cats = [...new Set(rs.map((r) => r.cat))];
  box.replaceChildren(...cats.map((c, ci) => {
    const card = el('div', 'sv-card'); card.append(el('h3', '', c));
    rs.filter((r) => r.cat === c).forEach((r) => {
      const d = el('div', 'sv-rule'); d.style.setProperty('--c', colr(ci + 2));
      const h = el('h4', '', r.title); if (r.when) { const w = el('span', 'sv-when', r.when); w.style.marginLeft = '.5em'; h.append(w); }
      d.append(h, el('p', '', r.detail));
      if (r.url) { const a = el('a', '', 'మూలం ↗'); a.href = r.url; a.target = '_blank'; a.rel = 'noopener'; d.append(a); }
      card.append(d);
    });
    return card;
  }));
}

/* ---------- tabs ---------- */
const DRAW = { overview: drawOverview, weekly: drawWeekly, festivals: drawFestivals, series: drawSeries, chapters: drawChapters, resources: drawResources, rules: drawRules };
function go(tab, link = true) {
  if (!DRAW[tab]) tab = 'overview';
  state.tab = tab;
  $$('.sv-tabs button').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tab === tab)));
  $$('.sv-page').forEach((p) => { p.hidden = p.id !== tab; });
  if (link) dash.setLink(tab);
  DRAW[tab]();
  drawKpis();
}
$$('.sv-tabs button').forEach((b) => b.addEventListener('click', () => go(b.dataset.tab)));
dash.onData(() => { drawKpis(); DRAW[state.tab](); });
const named = location.hash.slice(1);
go(DRAW[named] ? named : 'overview', false);
</script>

