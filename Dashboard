<script>
dash.calc('totals', {
  inputs: ['budget', 'channels'],
  title: 'బడ్జెట్, వీడియోల మొత్తాలు',
  description: 'నెలవారీ, 6 నెలల బడ్జెట్ వరుసల మొత్తం (₹ లక్షల్లో) మరియు ఛానళ్ల పెద్ద వీడియోల మొత్తం.',
  fn: (budget, channels) => {
    const sum = (rs, f) => rs.reduce((a, r) => a + Number(r[f]), 0);
    const m = budget.filter((r) => r.section === 'నెలవారీ');
    const s = budget.filter((r) => r.section === '6 నెలలు');
    const v = sum(channels, 'long_videos');
    return [
      { metric: 'monthly', low: Math.round(sum(m, 'low') / 1e4) / 10, high: Math.round(sum(m, 'high') / 1e4) / 10 },
      { metric: 'six', low: Math.round(sum(s, 'low') / 1e5), high: Math.round(sum(s, 'high') / 1e5) },
      { metric: 'videos', low: v, high: v },
    ];
  },
});
</script>

<script>
const $ = (s, r = document) => r.querySelector(s);
const $$ = (s, r = document) => [...r.querySelectorAll(s)];
const el = (tag, cls, text) => { const e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; };
const CHN = { dd: 'ధర్మ దీపం', ss: 'స్తోత్ర సుధ', pm: 'పూజా మందిరం', vv: 'వేద వాణి', all: 'అన్ని ఛానళ్లు' };
const CHI = { dd: 0, ss: 1, pm: 2, vv: 5, all: 6 };
const PHASES = ['ఆశ్వయుజం · దీపావళి', 'కార్తీక మాసం', 'మార్గశిరం · ధనుర్మాసం', 'పుష్యం · మాఘం', 'ఫాల్గుణం · చైత్రం'];
const colr = (i) => dash.colors[i % dash.colors.length];
const MON = ['జన', 'ఫిబ్ర', 'మార్చి', 'ఏప్రి', 'మే', 'జూన్', 'జులై', 'ఆగ', 'సెప్టెం', 'అక్టో', 'నవం', 'డిసెం'];
const fmtD = (s) => { const [y, m, d] = String(s).slice(0, 10).split('-').map(Number); return d + ' ' + MON[m - 1] + ' ' + y; };
const fmtDs = (s) => { const [, m, d] = String(s).slice(0, 10).split('-').map(Number); return d + ' ' + MON[m - 1]; };
const pd = (s) => { const [y, m, d] = String(s).slice(0, 10).split('-').map(Number); return new Date(Date.UTC(y, m - 1, d)); };
const inr = (n) => '₹' + Number(n).toLocaleString('en-IN');
const today = (() => { const t = new Date(); return new Date(Date.UTC(t.getFullYear(), t.getMonth(), t.getDate())); })();

const state = { tab: 'overview', wkCh: 'all', wkPh: 'all', wkQ: '', feKind: 'all', feQ: '', feSort: 'date', feDir: 1, seCh: 'all', reCat: 'all' };

function failBox(box, id) {
  const d = dash.data(id);
  if (d.status === 'error' || d.status === 'connect' || d.status === 'declined') {
    box.classList.remove('dash-skeleton');
    box.replaceChildren(el('div', 'sv-fail', 'లోడ్ కాలేదు'));
    return true;
  }
  if (d.status !== 'ok') { box.replaceChildren(); box.classList.add('dash-skeleton'); return true; }
  box.classList.remove('dash-skeleton');
  return false;
}
const rowsOf = (id) => { const d = dash.data(id); if (d.status !== 'ok') return null; let r = d.data; return Array.isArray(r) ? r : (r && (r.rows || r.data)) || []; };

/* ---------- header KPIs ---------- */
function drawKpis() {
  $$('#kpis [data-source], .sv-card .sub [data-source]').forEach((m) => {
    const id = m.dataset.source; const rs = rowsOf(id);
    if (!rs) { m.textContent = '—'; return; }
    m.classList.remove('dash-skeleton');
    const [k, v] = (m.dataset.where || '').split('=');
    const r = rs.find((x) => String(x[k]) === v);
    m.textContent = r ? String(r[m.dataset.field]) : '—';
  });
}

/* ---------- chips helper ---------- */
function chips(host, opts, cur, onPick) {
  host.replaceChildren(...opts.map(([val, label, c]) => {
    const b = el('button', 'sv-chip'); b.type = 'button';
    b.setAttribute('aria-pressed', String(val === cur));
    if (c != null) { const d = el('i', 'sv-dot'); d.style.setProperty('--c', c); b.append(d); }
    b.append(document.createTextNode(label));
    b.addEventListener('click', () => onPick(val));
    return b;
  }));
}

/* ---------- OVERVIEW ---------- */
function drawOverview() {
  const box = $('#ch-cards');
  if (!failBox(box, 'channels')) {
    box.replaceChildren(...rowsOf('channels').map((c) => {
      const card = el('div', 'sv-card sv-ch'); card.style.setProperty('--c', colr(CHI[c.id]));
      const h = el('div'); h.append(el('div', 'nm', c.name), el('div', 'en', c.name_en + ' · ' + c.role));
      const dl = el('dl');
      [['ఉద్దేశ్యం', c.purpose], ['ఫార్మాట్', c.format], ['క్రమం', c.cadence], ['ప్రారంభం', c.launch_te]].forEach(([k, v]) => dl.append(el('dt', '', k), el('dd', '', v)));
      card.append(h, dl);
      return card;
    }));
  }
  const bars = $('#ch-bars');
  if (!failBox(bars, 'channels')) {
    const rs = rowsOf('channels'); const mx = d3.max(rs, (r) => Number(r.long_videos)) || 1;
    bars.replaceChildren(...rs.map((c) => {
      const row = el('div', 'sv-hrow');
      const tr = el('div', 'sv-track'); const f = el('div', 'sv-fill'); f.style.setProperty('--c', colr(CHI[c.id]));
      f.style.left = '0'; f.style.width = (Number(c.long_videos) / mx * 100) + '%'; tr.append(f);
      row.append(el('span', '', c.name), tr, el('span', 'sv-num', String(c.long_videos)));
      return row;
    }));
  }
  drawTimeline();
  const act = $('#actions');
  if (!failBox(act, 'rules')) {
    act.replaceChildren(...rowsOf('rules').filter((r) => r.cat === 'తక్షణ కార్యాచరణ').map((r) => {
      const li = el('li'); const t = el('div'); const b = el('b', '', r.title); t.append(b, el('div', 'sub', r.detail));
      t.lastChild.style.color = 'var(--color-fg-muted)'; t.lastChild.style.fontSize = 'var(--cds-font-size-caption)';
      li.append(el('span', 'sv-when', r.when), t); return li;
    }));
  }
}

function drawTimeline() {
  const box = $('#timeline');
  const leg = $('#tl-legend');
  leg.replaceChildren(...PHASES.map((p, i) => { const s = el('span'); const d = el('i', 'sv-dot'); d.style.setProperty('--c', colr(i)); s.append(d, document.createTextNode(p)); return s; }));
  if (failBox(box, 'weeks') || failBox(box, 'festivals')) return;
  const weeks = rowsOf('weeks'); const fests = rowsOf('festivals').filter((f) => String(f.event).startsWith('★'));
  const W = Math.max(280, box.clientWidth || 600), H = 130, m = { l: 8, r: 8, t: 34, b: 30 };
  const x = d3.scaleUtc([pd('2026-10-20'), pd('2027-04-21')], [m.l, W - m.r]);
  const svg = d3.create('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`).style('display', 'block').style('overflow', 'visible');
  const tip = el('div', 'sv-tip'); tip.hidden = true;
  const show = (ev, html) => { tip.replaceChildren(...html); tip.hidden = false; const r = box.getBoundingClientRect(); let lx = ev.clientX - r.left + 10; if (lx > r.width - 180) lx = Math.max(0, lx - 200); tip.style.left = lx + 'px'; tip.style.top = (ev.clientY - r.top + 12) + 'px'; };
  const hide = () => { tip.hidden = true; };
  weeks.forEach((w, i) => {
    const s = pd(w.start); const e = i < weeks.length - 1 ? pd(weeks[i + 1].start) : pd('2027-04-21');
    const pi = Math.max(0, PHASES.indexOf(w.phase));
    const g = svg.append('g');
    g.append('rect').attr('x', x(s) + 1).attr('y', m.t).attr('width', Math.max(1, x(e) - x(s) - 2)).attr('height', 26).attr('rx', 4).style('fill', colr(pi))
      .attr('opacity', (today >= s && today < e) ? 1 : .78)
      .on('mousemove', (ev) => show(ev, [el('div', 'd', w.week + ' · ' + w.dates), el('div', '', w.anchors)])).on('mouseleave', hide)
      .on('click', () => { state.wkQ = ''; go('weekly'); setTimeout(() => { const t = document.getElementById('wk-' + w.week); if (t) t.scrollIntoView({ block: 'start' }); }, 30); }).style('cursor', 'pointer');
    if (W > 500 || i % 3 === 0) g.append('text').attr('x', (x(s) + x(e)) / 2).attr('y', m.t + 17).attr('text-anchor', 'middle').style('fill', 'var(--color-bg)').attr('font-size', 10).style('pointer-events', 'none').text(w.week.slice(1));
  });
  const months = d3.utcMonth.range(pd('2026-11-01'), pd('2027-04-21'));
  months.forEach((mo) => {
    svg.append('line').attr('x1', x(mo)).attr('x2', x(mo)).attr('y1', m.t - 4).attr('y2', m.t + 32).style('stroke', 'var(--cds-chart-reference)').attr('stroke-dasharray', '2 3');
    svg.append('text').attr('x', x(mo) + 3).attr('y', H - 8).attr('font-size', 11).style('fill', 'var(--color-fg-muted)').text(MON[mo.getUTCMonth()]);
  });
  svg.append('text').attr('x', m.l).attr('y', H - 8).attr('font-size', 11).style('fill', 'var(--color-fg-muted)').text('అక్టో');
  let lastX = -99, lane = 0;
  fests.forEach((f) => {
    const fx = x(pd(f.date)); lane = (fx - lastX < 14) ? (lane + 1) % 2 : 0; lastX = fx;
    const cy = m.t - 10 - lane * 13;
    svg.append('text').attr('x', fx).attr('y', cy + 4).attr('text-anchor', 'middle').attr('font-size', 13).style('fill', 'var(--color-warn)').style('cursor', 'default').text('★')
      .on('mousemove', (ev) => show(ev, [el('div', 'd', fmtD(f.date) + ' · ' + f.vaaram), el('div', '', String(f.event).replace('★ ', ''))])).on('mouseleave', hide);
  });
  if (today >= pd('2026-10-20') && today <= pd('2027-04-21')) {
    svg.append('line').attr('x1', x(today)).attr('x2', x(today)).attr('y1', m.t - 2).attr('y2', m.t + 30).style('stroke', 'var(--color-fg)').attr('stroke-width', 2);
  }
  box.replaceChildren(svg.node(), tip);
}

/* ---------- WEEKLY ---------- */
function currentWeek(weeks) {
  let cur = null;
  weeks.forEach((w, i) => { const s = pd(w.start); const e = i < weeks.length - 1 ? pd(weeks[i + 1].start) : pd('2027-04-21'); if (today >= s && today < e) cur = w.week; });
  if (!cur && weeks.length && today < pd(weeks[0].start)) cur = weeks[0].week;
  return cur;
}
function drawWeekly() {
  chips($('#wk-ch'), [['all', 'అన్ని ఛానళ్లు', null], ...['dd', 'ss', 'pm', 'vv'].map((k) => [k, CHN[k], colr(CHI[k])])], state.wkCh, (v) => { state.wkCh = v; drawWeekly(); });
  chips($('#wk-ph'), [['all', 'అన్ని మాసాలు', null], ...PHASES.map((p, i) => [p, p, colr(i)])], state.wkPh, (v) => { state.wkPh = v; drawWeekly(); });
  const box = $('#weeks');
  if (failBox(box, 'weeks')) return;
  const weeks = rowsOf('weeks'); const cur = currentWeek(weeks);
  const q = state.wkQ.trim();
  const keys = state.wkCh === 'all' ? ['dd', 'ss', 'pm', 'vv'] : [state.wkCh];
  const list = weeks.filter((w) => (state.wkPh === 'all' || w.phase === state.wkPh) && (!q || [w.anchors, ...keys.map((k) => w[k])].join(' ').includes(q)));
  if (!list.length) { box.replaceChildren(el('div', 'sv-empty', 'ఈ ఎంపికకు వారాలు లేవు.')); return; }
  box.replaceChildren(...list.map((w) => {
    const pi = Math.max(0, PHASES.indexOf(w.phase));
    const card = el('article', 'sv-wk' + (w.week === cur ? ' now' : '')); card.id = 'wk-' + w.week; card.style.setProperty('--c', colr(pi));
    const h = el('div', 'sv-wkh'); h.append(el('span', 'w', w.week), el('span', 'dt', w.dates), el('span', 'sv-pill', w.phase));
    if (w.week === cur) { const n = el('span', 'sv-now', today < pd(w.start) ? 'తదుపరి వారం' : 'ఈ వారం'); n.style.setProperty('--c', colr(pi)); h.append(n); }
    const cols = el('div', 'sv-wcols');
    keys.forEach((k) => {
      const c = el('div', 'sv-wcol'); c.style.setProperty('--c', colr(CHI[k]));
      c.append(el('h4', '', CHN[k]));
      const ul = el('ul');
      String(w[k] || '').split('\n').filter(Boolean).forEach((line) => {
        const li = el('li'); const i = line.indexOf(' · ');
        if (i > 0 && i < 18) { li.append(el('b', '', line.slice(0, i)), document.createTextNode(line.slice(i + 3))); } else li.textContent = line;
        ul.append(li);
      });
      c.append(ul); cols.append(c);
    });
    card.append(h, el('div', 'sv-anch', '📅 ' + w.anchors), cols);
    return card;
  }));
}
$('#wk-q').addEventListener('input', (e) => { state.wkQ = e.target.value; drawWeekly(); });
$('#wk-now').addEventListener('click', () => {
  const rs = rowsOf('weeks'); if (!rs) return;
  state.wkCh = 'all'; state.wkPh = 'all'; state.wkQ = ''; $('#wk-q').value = ''; drawWeekly();
  const t = document.getElementById('wk-' + currentWeek(rs)); if (t) t.scrollIntoView({ block: 'start' });
});

/* ---------- FESTIVALS ---------- */
const STC = { 'ధృవీకరణ': 'ok', 'లెక్కింపు': 'mut', 'సందేహం': 'warn' };
function drawFestivals() {
  const tbl = $('#fe-tbl'); const tb = $('tbody', tbl);
  const rs = rowsOf('festivals');
  const kinds = rs ? [...new Set(rs.map((r) => r.kind))] : [];
  chips($('#fe-kind'), [['all', 'అన్నీ', null], ...kinds.map((k) => [k, k, null])], state.feKind, (v) => { state.feKind = v; drawFestivals(); });
  if (!rs) { tb.replaceChildren(); return; }
  const q = state.feQ.trim();
  const list = rs.filter((r) => (state.feKind === 'all' || r.kind === state.feKind) && (!q || (r.event + ' ' + r.note + ' ' + r.masam).includes(q)))
    .sort((a, b) => state.feDir * String(a[state.feSort]).localeCompare(String(b[state.feSort])));
  $$('th button[data-sort]', tbl).forEach((b) => b.parentElement.setAttribute('aria-sort', b.dataset.sort === state.feSort ? (state.feDir > 0 ? 'ascending' : 'descending') : 'none'));
  tb.replaceChildren(...list.map((r) => {
    const tr = el('tr', String(r.event).startsWith('★') ? 'star' : ''); tr.dataset.key = r.date;
    const st = el('span', 'sv-st ' + (STC[r.status] || 'mut'), r.status);
    const src = el('td'); if (r.source) { const a = el('a', '', 'లింక్ ↗'); a.href = r.source; a.target = '_blank'; a.rel = 'noopener'; a.style.color = 'var(--color-fg-muted)'; src.append(a); }
    const stc = el('td'); stc.append(st);
    tr.append(el('td', '', fmtD(r.date)), el('td', '', r.vaaram), el('td', '', r.event), el('td', '', r.masam), el('td', '', r.kind), stc, el('td', '', r.note), src);
    if (pd(r.date) < today) tr.style.opacity = .55;
    return tr;
  }));
}
$('#fe-q').addEventListener('input', (e) => { state.feQ = e.target.value; drawFestivals(); });
$$('#fe-tbl th button[data-sort]').forEach((b) => b.addEventListener('click', () => { if (state.feSort === b.dataset.sort) state.feDir *= -1; else { state.feSort = b.dataset.sort; state.feDir = 1; } drawFestivals(); }));

/* ---------- SERIES ---------- */
function drawSeries() {
  chips($('#se-ch'), [['all', 'అన్ని ఛానళ్లు', null], ...['dd', 'ss', 'pm', 'vv'].map((k) => [k, CHN[k], colr(CHI[k])])], state.seCh, (v) => { state.seCh = v; drawSeries(); });
  const box = $('#se-cards');
