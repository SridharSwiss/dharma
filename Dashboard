    const ul = el('ul', 'sv-links');
    (links || []).forEach((l) => { const li = el('li'); const a = el('a', '', l.l); a.href = l.u; a.target = '_blank'; a.rel = 'noopener'; li.append(el('i', 'sv-v ' + l.v, l.v), a); ul.append(li); });
    const lh = el('div', '', '📚 గ్రంథ లింకులు'); lh.style.cssText = 'font-size:var(--cds-font-size-caption);font-weight:var(--cds-font-weight-medium)';
    card.append(head, meta, p, lh, ul);
    return card;
